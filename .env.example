# =============================================================================
# One .env for the whole stack. Copy this to `.env` in the project root
# (same folder as docker-compose.yml) and fill in real values.
#
# Read by:
#   - docker-compose.yml itself (the ${MYSQL_*} and ${VITE_API_BASE_URL}
#     placeholders in the mysql/nginx services — Compose loads this
#     automatically because it's named exactly ".env")
#   - backend + celery-worker containers, via `env_file: ./.env`
# =============================================================================

# -----------------------------------------------------------------------------
# MySQL — used by the mysql service AND must match the credentials inside
# DATABASE_URL below
# -----------------------------------------------------------------------------
MYSQL_DATABASE=demand_forecast
MYSQL_USER=demand_user
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

# -----------------------------------------------------------------------------
# FastAPI database connection
# Host is "mysql" — the service name in docker-compose.yml, not localhost —
# because containers reach each other by service name on the compose network.
# -----------------------------------------------------------------------------
DATABASE_URL=mysql+pymysql://demand_user:CHANGE_ME@mysql:3306/demand_forecast

# -----------------------------------------------------------------------------
# JWT
# Generate a real secret with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# -----------------------------------------------------------------------------
# Redis / Celery — host is "redis", the compose service name
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
USE_CELERY=true

# -----------------------------------------------------------------------------
# Application
# Set COOKIE_SECURE=true once you're serving over HTTPS in production
# -----------------------------------------------------------------------------
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
REFRESH_TOKEN_EXPIRE_DAYS=7
OTP_SESSION_EXPIRE_MINUTES=5
CACHE_EXPIRE_SECONDS=300

# -----------------------------------------------------------------------------
# CORS
# Same-origin via nginx means this mainly matters for local `vite dev` only.
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173

# -----------------------------------------------------------------------------
# SMTP — fill these in when provided by the team (password-reset OTP emails
# won't send without them, everything else works fine)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# -----------------------------------------------------------------------------
# Frontend build arg (baked into the JS bundle at build time, not runtime)
# Keep as /api for the nginx same-origin setup.
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=/api
