# Git / editor metadata
.git/
.gitignore
.vscode/
.idea/
.DS_Store

# Secrets
.env
.env.*
!.env.example
Backend/.env
Backend/.env.*
!Backend/.env.example

# Python / Node dependencies and caches
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/venv/
**/.venv/
**/node_modules/
**/dist/
**/build/

# Logs / local tooling
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# The nginx image only needs Frontend/app and nginx/. Keep the backend out of
# the nginx build context entirely.
Backend/

# Local frontend artifacts
Frontend/app/node_modules/
Frontend/app/dist/

# Local test / generated data
*.db
*.sqlite
*.sqlite3
Testing_markdown.md/
