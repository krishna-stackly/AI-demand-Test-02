# MySQL
MYSQL_DATABASE=demand_forecast
MYSQL_USER=demand_user
MYSQL_PASSWORD=DemandTest2026
MYSQL_ROOT_PASSWORD=RootTest2026

# FastAPI database connection
DATABASE_URL=mysql+pymysql://demand_user:DemandTest2026@mysql:3306/demand_forecast

# JWT
JWT_SECRET_KEY=change-this-testing-secret-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
USE_CELERY=true

# Application
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
REFRESH_TOKEN_EXPIRE_DAYS=7
OTP_SESSION_EXPIRE_MINUTES=5
CACHE_EXPIRE_SECONDS=300

# CORS - temporary testing value
ALLOWED_ORIGINS=http://localhost:5173

# SMTP - fill these when provided by the team
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Frontend build arg (baked into the JS bundle at build time)
VITE_API_BASE_URL=/api
